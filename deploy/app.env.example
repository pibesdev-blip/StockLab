# Variables de la API de StockLab en TEST.
# Copiar a deploy/app.env y aplicar: chmod 600 deploy/app.env
#
# DATABASE_URL NO va acá: la define el admin en SECRETS_FILE
# (/srv/infrastructure/secrets/stocklab_test.env).
# NODE_ENV, PORT y TRUST_PROXY los fija deploy/compose.test.yaml.

# Stock mínimo por defecto para productos nuevos (no es secreto).
DEFAULT_MIN_STOCK=5
