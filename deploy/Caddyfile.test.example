# Bloque de Caddy para StockLab en TEST. Lo aplica SOLO el admin.
# deploy.sh install genera deploy/Caddyfile.<slug>.generated con los valores reales.
{{TS_HOST}}:{{PORT_WEB}} {
	bind {{TS_IP}}
	encode zstd gzip
	handle /api/* {
		reverse_proxy 127.0.0.1:{{PORT_API}}
	}
	handle {
		root * /var/www/{{SLUG}}/test/dist
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
